# Copie para infra/osm/.env na VPS. O .env nunca vai para o Git.

# Senha do Postgres interno do Nominatim (obrigatória)
NOMINATIM_SENHA=troque-esta-senha

# Onde ficam o PBF e os arquivos do OSRM (padrão: infra/osm/dados). Precisa de uns 60 GB livres.
# OSM_DADOS=/srv/osm

# Interface das portas no host. 127.0.0.1 = só a própria VPS (coletor na mesma máquina).
# Coletor em outra máquina: o IP privado (VPN/rede interna) ou 0.0.0.0 COM firewall liberando só o coletor.
# OSM_BIND=127.0.0.1

# Threads da importação do Nominatim e do pré-processamento do OSRM (padrão: 8)
# OSM_THREADS=8

# Memória compartilhada do Postgres do Nominatim (recomendado: metade da RAM livre; padrão 4g)
# NOMINATIM_SHM=4g

# address (cidades e endereços, menor) ou full (inclui lugares). Trocar exige reimportar.
# NOMINATIM_ESTILO=address

# Overpass: processos de FastCGI e consultas simultâneas por IP
# OVERPASS_PROCESSOS=8
# OVERPASS_LIMITE=16

# Versões do OSRM guardadas além da atual (para voltar atrás); padrão 1
# OSRM_MANTER=1
