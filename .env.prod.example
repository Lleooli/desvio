# Copie para .env na VPS (`cp .env.prod.example .env`) e troque os placeholders.
# Este arquivo pode ir para o Git. O .env, não. Não coloque chave, senha nem IP aqui.

# Contato real. O Nominatim exige o e-mail no User-Agent; o mesmo endereço recebe
# o aviso de validade do certificado. Não deixe o placeholder.
PV_USER_AGENT=desvio/0.1 (contato@seudominio)
PV_ACME_EMAIL=contato@seudominio

# Domínio da API. O Caddy escuta 80 e 443 e serve https://<domínio>/docs
PV_DOMINIO=api.seudominio

PV_AMBIENTE=producao
# URL pública da API, para as fotos da Places API. Com gosom pode ficar comentada.
# PV_API_URL_PUBLICA=https://api.seudominio

# Sobe o gosom (1 a 2 GB de RAM). Para trocar pela Places API oficial, apague esta
# linha e preencha a chave (docs/deploy.md).
COMPOSE_PROFILES=gosom
# PV_GOOGLE_PLACES_KEY=
# PV_GOOGLE_FONTE=places

# Postgres e login ficam no Supabase, não nesta VPS.
PV_DATABASE_URL=
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=

# GET /uso/ia. Sem ele, a rota responde 404.
# PV_ADMIN_TOKEN=

# CORS fechado com PV_AMBIENTE=producao. O app nativo não manda Origin.
# PV_CORS_ORIGINS=
