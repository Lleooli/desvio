# Copie para .env e preencha. O .env nunca vai para o Git.

# Nominatim exige um contato real no User-Agent
PV_USER_AGENT=desvio/0.1 (seu-email@exemplo.com)

# Groq (https://console.groq.com/keys). Sem chave, a IA cai no plano B.
GROQ_API_KEY=
# Opcionais
# PV_MODELO_RACIOCINIO=openai/gpt-oss-120b
# PV_MODELO_RAPIDO=openai/gpt-oss-20b

# Supabase (painel do projeto: Connect e Project Settings > API). Só a chave anônima vai para o app.
# Connection string do Postgres; no Supabase, a do pooler (Connect > Session pooler).
PV_DATABASE_URL=
# URL do projeto: a API busca as chaves públicas do JWT em SUPABASE_URL/auth/v1/.well-known/jwks.json
SUPABASE_URL=
# Só para projetos com o segredo JWT antigo (HS256); projetos novos deixam vazio
SUPABASE_JWT_SECRET=
# Vai para o app (apps/mobile), nunca a service_role
SUPABASE_ANON_KEY=

# Em produção, PV_AMBIENTE=producao fecha o CORS a quem não estiver em PV_CORS_ORIGINS
# PV_AMBIENTE=producao

# Origens liberadas no CORS, separadas por vírgula (padrão: * fora de produção)
# PV_CORS_ORIGINS=http://localhost:8081

# Servidores próprios (padrão: públicos)
# PV_OSRM_URL=
# PV_OSRM_BIKE_URL=
# PV_NOMINATIM_URL=
# PV_OVERPASS_URL=

# Validade do cache de lugares, rotas e geocodificação, em dias (padrão: 30)
# PV_CACHE_DIAS=30
