# Copie para .env e preencha. O .env nunca vai para o Git.

# Nominatim exige um contato real no User-Agent
PV_USER_AGENT=desvio/0.1 (seu-email@exemplo.com)

# Groq (https://console.groq.com/keys). Sem chave, a IA cai no plano B.
GROQ_API_KEY=
# Opcionais
# PV_MODELO_RACIOCINIO=openai/gpt-oss-120b
# PV_MODELO_RAPIDO=openai/gpt-oss-20b

# Supabase (painel do projeto: Connect e Project Settings > API). Só a chave anônima vai para o app.
# Connection string do Postgres; no Supabase, a do pooler (Connect > Session pooler).
PV_DATABASE_URL=
# URL do projeto: a API busca as chaves públicas do JWT em SUPABASE_URL/auth/v1/.well-known/jwks.json
SUPABASE_URL=
# Só para projetos com o segredo JWT antigo (HS256); projetos novos deixam vazio
SUPABASE_JWT_SECRET=
# Vai para o app (apps/mobile), nunca a service_role
SUPABASE_ANON_KEY=
# Chave service_role (Project Settings > API). SÓ NO SERVIDOR: a API usa para apagar a conta
# no Supabase Auth quando a pessoa pede (LGPD, DELETE /eu). Nunca no app, nunca no Git.
SUPABASE_SERVICE_ROLE_KEY=

# Em produção, PV_AMBIENTE=producao fecha o CORS a quem não estiver em PV_CORS_ORIGINS
# PV_AMBIENTE=producao

# Origens liberadas no CORS, separadas por vírgula (padrão: * fora de produção)
# PV_CORS_ORIGINS=http://localhost:8081

# Google Maps (fotos, notas, horários). Só o servidor usa; nada disto vai para o app.
# Places API (New) oficial, para produção. Crie a chave no Google Cloud com só a "Places API (New)"
# liberada e restrita ao IP do servidor. Com a chave, a fonte padrão vira "places".
# PV_GOOGLE_PLACES_KEY=
# Força a fonte: places (API oficial) ou gosom (raspador, só desenvolvimento).
# Sem esta linha: places se houver chave, gosom se não houver.
# PV_GOOGLE_FONTE=places
# Endereço público da API, para as fotos da Places API virem com URL absoluta
# (sem ela, o card traz "/fotos/..." e o app junta com a base da API).
# Obrigatória com a Places API: sem ela as fotos saem com URL relativa e o app não as acha.
# PV_API_URL_PUBLICA=https://api.exemplo.com
# Segredo das URLs de foto (assinadas, valem 7 dias). Sem ele, deriva da chave do Google,
# e trocar a chave invalida as fotos já entregues.
# PV_FOTOS_SEGREDO=
# Teto de buscas pagas na Places API por viagem (o resto fica só com OpenStreetMap).
# Defina também uma cota diária no Google Cloud para não ter surpresa na fatura.
# PV_PLACES_MAX_BUSCAS=60
# Sobe o gosom junto no `docker compose up`. Em produção (Places API), apague esta linha.
COMPOSE_PROFILES=gosom

# Servidores próprios de OSRM, Nominatim e Overpass (padrão: os públicos). Como subir: infra/osm/README.md
# PV_OSRM_URL=http://127.0.0.1:5000                     (carro e moto)
# PV_OSRM_BIKE_URL=http://127.0.0.1:5001                (bicicleta)
# PV_NOMINATIM_URL=http://127.0.0.1:8088
# PV_OVERPASS_URL=http://127.0.0.1:12345/api/interpreter
# Segundos entre chamadas ao Nominatim (padrão 1.1, o limite do público). No servidor próprio: 0
# PV_NOMINATIM_INTERVALO=1.1

# Validade do cache de lugares, rotas e geocodificação, em dias (padrão: 30)
# PV_CACHE_DIAS=30

# De quanto em quanto tempo o worker tenta de novo apagar contas pendentes no Supabase Auth, em minutos (padrão: 10)
# PV_EXCLUSAO_INTERVALO_MIN=10
