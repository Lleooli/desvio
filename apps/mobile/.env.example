# Copie para apps/mobile/.env. Só variáveis EXPO_PUBLIC_ vão para o app, e elas ficam visíveis nele:
# nunca ponha chave secreta aqui (a do Groq e a service role do Supabase ficam só no servidor).

# URL do coletor. No aparelho, use o IP da máquina na rede (localhost é o próprio celular).
EXPO_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth: a URL do projeto e a chave anônima (Project Settings > API Keys). Nunca a service_role.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Onde estão publicados os Termos de uso e a Política de privacidade (links da tela Entrar).
EXPO_PUBLIC_TERMOS_URL=
EXPO_PUBLIC_PRIVACIDADE_URL=
