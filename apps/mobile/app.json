{
  "expo": {
    "name": "Desvio",
    "slug": "desvio",
    "scheme": "desvio",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.desvio"
    },
    "android": {
      "package": "app.desvio"
    },
    "plugins": ["expo-router", "expo-font"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
