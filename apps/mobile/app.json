{
  "expo": {
    "name": "Desvio",
    "slug": "desvio",
    "scheme": "desvio",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.desvio",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "app.desvio"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "622be9fc-1a3b-45c5-9c2b-798c81680c8c"
      }
    },
    "owner": "lleooliv"
  }
}
